# X-SuperPlay Global Edge
# Copy this file to .env for local configuration rendering.
# Never commit the real .env file.

COMPOSE_PROJECT_NAME=x-superplay-global-edge
# local | production. When set to production, validate.sh additionally
# requires a non-empty EDGE_PUBLIC_HOST and EDGE_DISABLE_IPV6=true
# (G1 is IPv4-first; see docs/architecture.md and docs/acceptance.md).
EDGE_ENV=local
TZ=Asia/Shanghai

# Public IPv4/DNS of the actual edge origin. In the full-tunnel model this
# is also the expected public egress identity after traffic exits the VPN.
# MUST stay empty in this tracked template. On the real server set, for example:
#   EDGE_PUBLIC_HOST=<PUBLIC_EDGE_HOST>
EDGE_PUBLIC_HOST=

# Optional client-facing WireGuard endpoint. Leave empty for direct mode, in
# which clients connect straight to EDGE_PUBLIC_HOST. Set this to an approved
# accelerated ingress VIP/hostname when the origin is retained but the
# cross-border ingress path changes.
# In accelerated mode:
#   client Endpoint Host = EDGE_WIREGUARD_ENDPOINT_HOST
#   expected VPN egress  = EDGE_PUBLIC_HOST
# wg-easy v15 does not read this variable automatically; onboarding Host must
# be set to this value when non-empty, otherwise to EDGE_PUBLIC_HOST.
EDGE_WIREGUARD_ENDPOINT_HOST=

# Reviewed upstream release, locked by BOTH human-readable tag and OCI index
# digest. The digest prevents an upstream tag re-push from changing the bytes
# used by CI or the first VPS. Upgrades require a repository change + green CI.
WGEASY_IMAGE=ghcr.io/wg-easy/wg-easy:15.4.0@sha256:0e7bc9d34e86ddcaa92bc700d4d7dc9b33291dbc07ac8d13382f7c2095f949ec

# Expected WireGuard UDP port. This is the host-side Docker publish port AND
# the expected wg-easy listen/client-endpoint port. Compose maps
#   host ${EDGE_WIREGUARD_PORT}/udp -> container ${EDGE_WIREGUARD_PORT}/udp
# wg-easy actually listens on the port stored in its persistent state, so
# onboarding Port MUST equal this value. After onboarding,
# scripts/wireguard-check.sh fails loudly when the real listen port differs.
EDGE_WIREGUARD_PORT=51820

# A P8 handshake is accepted as current evidence only when the newest
# WireGuard handshake is no older than this many seconds. 300 seconds is
# deliberately short enough to reject stale historical handshakes while
# allowing the operator to run the server-side gate immediately after L3 E2E.
EDGE_HANDSHAKE_MAX_AGE_S=300

# Incident-stabilization MTU. Real traffic on an earlier path showed
# a repeatable PMTU blackhole at 1420 (large HTTPS transfers stalled) while
# 1280 materially improved completion. Keep 1280 as the safe baseline until a
# controlled MTU sweep proves a higher value stable. This policy must match the
# wg-easy interface and generated Windows/Android client configs.
EDGE_WG_MTU=1280

# Windows P8 real-payload gate. A HEAD/HTTP-status response is not sufficient:
# the client must complete a full GitHub GET, transfer at least this many bytes,
# and meet the minimum average byte/s floor within the bounded timeout.
EDGE_CLIENT_PAYLOAD_MIN_BYTES=65536
EDGE_CLIENT_MIN_DOWNLOAD_BPS=65536
EDGE_CLIENT_PAYLOAD_MAX_TIME_S=90

# Candidate/fixed-path TCP qualification thresholds.
# QUALIFIED requires both single-stream directions >= MIN. Either direction
# below REJECT is a hard path failure. Values between the two are degraded.
EDGE_PATH_MIN_TCP_MBPS=5
EDGE_PATH_REJECT_TCP_MBPS=1

# Fixed-edge UDP diagnostic profile used by
# scripts/edge-path-diagnose.sh. These values classify whether the direct
# route has UDP-specific impairment; they are not a production bandwidth SLA.
EDGE_PATH_UDP_TEST_MBPS=3
EDGE_PATH_UDP_MAX_LOSS_PCT=5

# G1 is IPv4-first: wg-easy is told to disable IPv6 client allocation and
# IPv6 firewall rules (upstream DISABLE_IPV6=true). The bridge network keeps
# the upstream IPv6 addressing structure (it is part of the reviewed compose
# model), but the VPN data plane hands out IPv4 only. Do not flip this to
# false for G1 without a reviewed IPv6 decision.
EDGE_DISABLE_IPV6=true

# The Web UI is intentionally loopback-only in the baseline stack.
# On a future VPS, reach it through an SSH tunnel or another reviewed
# private/TLS access path instead of exposing port 51821 publicly.
WG_ADMIN_BIND=127.0.0.1
WG_ADMIN_PORT=51821

# Runtime behavior.
WGEASY_DISABLE_VERSION_CHECK=false

# Bounded Docker log retention.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# wg-easy v15 stores normal setup state (admin credentials, Host/Port,
# clients, keys) in its persistent data volume (/etc/wireguard, SQLite
# state). Do NOT add INIT_PASSWORD or other real setup credentials to this
# tracked template. If unattended initialization is introduced later, P3/P5
# will define a separate untracked secret-injection path.
