# Edge data-plane profile: 2 vCPU / 2 GB RAM / 30 Mbps Singapore instance.
#
# Evidence gate: scripts/data-plane-sysctl.sh --apply refuses to run unless
# EDGE_SYSCTL_ACK=1 and a server-state capture labelled T0 is present. Collect
# it with:
#   bash scripts/g1-v2-server-state.sh .temp/server-state-T0.json T0
#
# Sizing: 30 Mbps at ~150 ms RTT is about 576 KB of bandwidth-delay product
# per flow. The 4 MB socket buffers below are roughly 7x that, which absorbs
# a cross-border loss burst without letting a single flow grow unbounded.
# Do not raise them to 16 MB on a 2 GB host: the buffers grow on demand, but
# the ceiling is the memory risk.

net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr

net.core.rmem_max = 4194304
net.core.wmem_max = 4194304
net.ipv4.tcp_rmem = 4096 87380 4194304
net.ipv4.tcp_wmem = 4096 65536 4194304
net.ipv4.udp_rmem_min = 16384
net.ipv4.udp_wmem_min = 16384

# Interactive traffic: an idle SSH session must not restart from slow start.
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_notsent_lowat = 131072
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_tw_reuse = 1
net.ipv4.ip_local_port_range = 10240 65000

# Connection and queue depth.
net.core.somaxconn = 4096
net.ipv4.tcp_max_syn_backlog = 2048
net.core.netdev_max_backlog = 4096
net.netfilter.nf_conntrack_max = 65536
net.netfilter.nf_conntrack_tcp_timeout_established = 3600
