# Normalize text line endings so scripts and templates behave identically
# across Windows/macOS/Linux checkouts and CI.
* text=auto

*.sh    text eol=lf
*.bash  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
.env.example text eol=lf
*.md    text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
